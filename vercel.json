{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run docs:build",
  "outputDirectory": "dist-site",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/availability-calendar/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/availability-calendar/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/availability-calendar/storybook/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
